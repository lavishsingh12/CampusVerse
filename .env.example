# ==============================================================================
# CampusVerse Environment Configuration Template
# Copy this file to .env before starting services locally.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your_super_secret_key_here_min_32_characters

# Development-only verification bypass. Keep disabled in production. When
# enabled, only these comma-separated test addresses may bypass email OTP.
ALLOW_DEV_EMAIL_VERIFICATION_BYPASS=False
DEV_EMAIL_VERIFICATION_BYPASS_ADDRESSES=
# Authentication, OTP & Verification
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Optional SMS provider configuration (e.g. Twilio)
SMS_PROVIDER_ACCOUNT_SID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_PROVIDER_FROM_NUMBER=

# Database Configuration (PostgreSQL)
# Local Docker compose uses: postgresql+asyncpg://postgres:postgres@localhost:5432/campusverse
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campusverse

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Frontend Service
NEXT_PUBLIC_API_URL=http://localhost:8000
